# Copy this file to .env.local and fill in the values. .env.local is never committed to git.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → API keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_). Safe to share.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (starts with sb_secret_). SECRET: paste it here yourself, never in chat or git.
SUPABASE_SECRET_KEY=

# Phase 2.4: Telegram alerts for new reports (bot from @BotFather). The token is SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 2.4: Cloudflare Turnstile bot check on forms. The site key is public; the secret key is SECRET.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Phase 2.5: where magic-link emails send the admin back to (no trailing slash)
SITE_URL=http://localhost:3000

# Data robot (robot/README.md). No AI or paid service; it only needs the Supabase settings above.
# A page universities can visit to learn about the robot or ask it to stop (shown in its User-Agent).
ROBOT_CONTACT_URL=
